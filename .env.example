# Copy to .env, chmod 600 .env, and set your public HTTPS origin.
# Configure each brand in Settings > Amazon SES after signing in.
POSTBOX_BASE_URL=https://mail.example.com
# Default region shown when configuring a new brand.
POSTBOX_AWS_REGION=eu-west-1
# Optional host loopback port for your TLS reverse proxy.
POSTBOX_PORT=8080

# Configure each brand’s access keys, SNS topic ARN and optional SQS queue URL in the WebUI.

POSTBOX_RETENTION_DAYS=90
POSTBOX_MAX_WORKERS=512
# POSTBOX_NOTIFICATION_FROM=
# POSTBOX_NOTIFICATION_TO=
# POSTBOX_TURNSTILE_SITE_KEY=
# POSTBOX_TURNSTILE_SECRET=
