# Copy to .env, chmod 600 .env, and set your public HTTPS origin and AWS region.
POSTBOX_BASE_URL=https://mail.example.com
POSTBOX_AWS_REGION=eu-west-1
# Optional host loopback port for your TLS reverse proxy.
POSTBOX_PORT=8080

# Prefer an instance/task role. Otherwise supply AWS credentials at runtime.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Optional SES event ingestion. SQS requires the expected SNS topic ARN.
# POSTBOX_SNS_TOPIC_ARN=arn:aws:sns:eu-west-1:123456789012:postbox-events
# POSTBOX_SQS_QUEUE_URL=https://sqs.eu-west-1.amazonaws.com/123456789012/postbox-events
# POSTBOX_SES_CONFIGURATION_SET=postbox

POSTBOX_RETENTION_DAYS=90
POSTBOX_MAX_WORKERS=512
# POSTBOX_NOTIFICATION_FROM=
# POSTBOX_NOTIFICATION_TO=
# POSTBOX_TURNSTILE_SITE_KEY=
# POSTBOX_TURNSTILE_SECRET=
