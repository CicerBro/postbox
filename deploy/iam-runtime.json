{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SendVerifiedIdentity",
      "Effect": "Allow",
      "Action": [
        "ses:SendEmail",
        "ses:SendRawEmail"
      ],
      "Resource": "arn:aws:ses:REGION:ACCOUNT:identity/example.com"
    },
    {
      "Sid": "SendWithConfigurationSet",
      "Effect": "Allow",
      "Action": [
        "ses:SendEmail",
        "ses:SendRawEmail"
      ],
      "Resource": [
        "arn:aws:ses:REGION:ACCOUNT:configuration-set/postbox",
        "arn:aws:ses:REGION:ACCOUNT:configuration-set/postbox-*"
      ]
    },
    {
      "Sid": "ReadDomainVerification",
      "Effect": "Allow",
      "Action": [
        "ses:GetEmailIdentity"
      ],
      "Resource": "arn:aws:ses:REGION:ACCOUNT:identity/example.com"
    },
    {
      "Sid": "AccountQuotaAndSuppressions",
      "Effect": "Allow",
      "Action": [
        "ses:GetAccount",
        "ses:ListEmailIdentities",
        "ses:ListSuppressedDestinations"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadEventDestination",
      "Effect": "Allow",
      "Action": [
        "ses:GetConfigurationSetEventDestinations"
      ],
      "Resource": [
        "arn:aws:ses:REGION:ACCOUNT:configuration-set/postbox",
        "arn:aws:ses:REGION:ACCOUNT:configuration-set/postbox-*"
      ]
    },
    {
      "Sid": "ReadEventSubscription",
      "Effect": "Allow",
      "Action": [
        "sns:ListSubscriptionsByTopic"
      ],
      "Resource": [
        "arn:aws:sns:REGION:ACCOUNT:postbox-events",
        "arn:aws:sns:REGION:ACCOUNT:postbox-*"
      ]
    }
  ]
}
