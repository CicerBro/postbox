POSTBOX_DB=/var/lib/postbox/postbox.db
POSTBOX_SECRET_FILE=/var/lib/postbox/tracking.secret
POSTBOX_LISTEN=127.0.0.1:8080
POSTBOX_BASE_URL=https://mail.example.com
POSTBOX_SECURE_COOKIES=true
POSTBOX_AWS_REGION=eu-west-1
POSTBOX_SNS_TOPIC_ARN=arn:aws:sns:eu-west-1:123456789012:postbox-events
POSTBOX_SQS_QUEUE_URL=https://sqs.eu-west-1.amazonaws.com/123456789012/postbox-events
POSTBOX_BACKUP_DIR=/var/lib/postbox/backups
POSTBOX_RETENTION_DAYS=90
POSTBOX_RECOVERY_POLICY=unknown
POSTBOX_SHUTDOWN_TIMEOUT=60s
# AWS credentials use the SDK standard chain. Prefer an EC2 instance role.
